# Keep the build context small and secrets out of the image.
.git/
.opencode/
.idea/
.vscode/

# Local secrets — injected at runtime via env_file, never baked in.
.env
.env.local
.env.*.local

# Air live-reload output and local cover storage (mounted as a volume instead).
tmp/
uploads/

# Go build / test artifacts.
*.exe
*.out
*.test
coverage.txt
coverage.html

# Rallya environment template — placeholder values only.
# Copy to .env and fill in: cp .env.example .env
# .env is gitignored (holds real credentials) — never commit it.
# compose.yaml ships working local-dev defaults for DATABASE_URL, APP_PORT,
# JWT_SECRET, QR_SIGNING_SECRET, and CORS; only override them here if needed.

# --- Core ---
# Local compose default: postgres://rallya:rallya@db:5432/rallya?sslmode=disable
DATABASE_URL=postgres://rallya:change-me@localhost:5432/rallya?sslmode=disable
APP_PORT=8080
APP_URL=http://localhost:8080

# --- Auth (fail-closed: 32+ random bytes in production, e.g. openssl rand -hex 32) ---
JWT_SECRET=change-me-to-32-plus-random-bytes-minimum
QR_SIGNING_SECRET=change-me-to-32-plus-random-bytes-minimum
# Local dev escape hatch only; never true in production.
ALLOW_INSECURE_JWT=false
# ACCESS_TTL_MINUTES=15
# REFRESH_TTL_DAYS=30
SUPERADMIN_EMAILS=admin@example.com

# --- CORS / proxies / rate limits ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
# TRUSTED_PROXIES=
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_DEFAULT_PER_MIN=600

# --- Mail (unset = logged only, requests still succeed) ---
# EMAIL_SERVICE=Gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_ADDRESS=
# EMAIL_PASSWORD=

# --- Stripe (unset = checkout endpoints 503, boot unaffected) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOKS_SIGNING_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring prices for org subscription tiers (price_... from the dashboard).
# Empty = that tier cannot be purchased (checkout 503s for it).
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_SCALE=

# --- Cloudinary covers (unset = local disk under ./uploads) ---
# CLOUDINARY_URL=
# CLOUD_NAME=
# CLOUD_API_KEY=
# CLOUD_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=

# --- Redis (unset = memory rate-limit store, caching disabled) ---
# Host default for `go run ./cmd/api`: redis://localhost:6379/0
# Compose default (already wired in compose.yaml): redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
